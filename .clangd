CompileFlags:
  Remove:
    - "-fabi-version=*"
  Add:
    - "-mcpu=cortex-m4"
    - "-mthumb"
    - "-mfpu=fpv4-sp-d16"
    - "-mfloat-abi=hard"
    - "-DSOC_FAMILY_STM32"
    - "-DSOC_SERIES_STM32F4"
    - "-DUSE_HAL_DRIVER"
    - "-DSTM32F407xx"
    - "-IG:/CODE/FOC/F407-FOC/applications"
    - "-IG:/CODE/FOC/F407-FOC/drivers"
    - "-IG:/CODE/FOC/F407-FOC/drivers/include"
    - "-IG:/CODE/FOC/F407-FOC/drivers/include/config"
    - "-IG:/CODE/FOC/F407-FOC/libraries/CMSIS/Include"
    - "-IG:/CODE/FOC/F407-FOC/libraries/CMSIS/Device/ST/STM32F4xx/Include"
    - "-IG:/CODE/FOC/F407-FOC/libraries/CMSIS/RTOS/Template"
    - "-IG:/CODE/FOC/F407-FOC/libraries/STM32F4xx_HAL_Driver/Inc"
    - "-IG:/CODE/FOC/F407-FOC/libraries/STM32F4xx_HAL_Driver/Inc/Legacy"
    - "-IG:/CODE/FOC/F407-FOC/cubemx"
    - "-IG:/CODE/FOC/F407-FOC/cubemx/Inc"
    - "-IG:/CODE/FOC/F407-FOC/simpleFoc/common"
    - "-IG:/CODE/FOC/F407-FOC/simpleFoc/common/base_classes"
    - "-isystemF:/RT-ThreadStudio/repo/Extract/ToolChain_Support_Packages/ARM/GNU_Tools_for_ARM_Embedded_Processors/5.4.1/arm-none-eabi/include"
    - "-isystemF:/RT-ThreadStudio/repo/Extract/ToolChain_Support_Packages/ARM/GNU_Tools_for_ARM_Embedded_Processors/5.4.1/lib/gcc/arm-none-eabi/5.4.1/include"
    - "-isystemF:/RT-ThreadStudio/repo/Extract/ToolChain_Support_Packages/ARM/GNU_Tools_for_ARM_Embedded_Processors/5.4.1/lib/gcc/arm-none-eabi/5.4.1/include-fixed"
